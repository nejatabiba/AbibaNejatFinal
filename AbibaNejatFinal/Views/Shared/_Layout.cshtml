<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimeList</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="@ViewData["BodyClass"]">
    <nav class="navbar">
        <a asp-controller="Home" asp-action="Index" class="logo">AnimeList</a>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Home" asp-action="About">About</a></li>
            <li><a asp-controller="Anime" asp-action="Browse">Browse</a></li>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="Anime" asp-action="MyList">My List</a></li>
                <li>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Login">Login</a></li>
            }
        </ul>
    </nav>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
