<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - AnimeList</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <nav class="navbar">
        <div class="logo">AnimeList</div>
        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Browse", "Anime")">Browse</a></li>
            <li><a href="@Url.Action("Login", "Account")">Login</a></li>
        </ul>
    </nav>

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">© @DateTime.Now.Year - Your Name</div>
    </footer>
</body>
</html>
