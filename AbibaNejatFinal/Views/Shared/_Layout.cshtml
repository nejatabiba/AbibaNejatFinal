<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - AnimeList</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <nav class="navbar">
        <div class="logo">AnimeList</div>
        <ul class="nav-links">
            <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-area="" asp-controller="Anime" asp-action="Browse">Browse</a></li>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link" style="color:#fff; text-decoration:none; background:none; border:none; padding:0; cursor:pointer; font-size: 16px; line-height: 21px;">
                            Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li><a asp-area="" asp-controller="Account" asp-action="Login">Login</a></li>
                <li><a asp-area="" asp-controller="Account" asp-action="Register">Register</a></li>
            }
        </ul>
    </nav>

    <div class="container mt-3">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">© @DateTime.Now.Year - Nejat Abiba</div>
    </footer>
</body>
</html>
