@model AbibaNejatFinal.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In - AnimeList";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/account.css" />
</head>
<body>
    <nav class="navbar">
        <a href="@Url.Action("Index", "Home")" class="logo">AnimeList</a>
        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Browse", "Anime")">Browse</a></li>
            <li><a href="@Url.Action("Register", "Account")">Sign Up</a></li>
        </ul>
    </nav>

    <div class="auth-container">
        <div class="auth-card">
            <h1>Welcome Back</h1>
            <p class="subtitle">Sign in to continue your anime journey</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="validation-summary">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] ?? "")" />

                <div class="form-group">
                    <label asp-for="UsernameOrEmail">Username or Email</label>
                    <input asp-for="UsernameOrEmail" type="text" placeholder="Enter your username or email" />
                    <span asp-validation-for="UsernameOrEmail" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="remember-me">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                    <label asp-for="RememberMe" for="rememberMe">Keep me logged in</label>
                </div>

                <button type="submit" class="btn btn-primary">Sign In</button>
            </form>

            <div class="auth-link bordered">
                Don't have an account? <a href="@Url.Action("Register", "Account")">Sign Up</a>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
