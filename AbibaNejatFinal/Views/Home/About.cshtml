@{
    ViewData["Title"] = "About";
    ViewData["BodyClass"] = "about-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" />
}

<div class="hero-banner"></div>

<div class="container">
    <div class="about-details">
        <div class="profile-photo">
            <img src="~/images/Nejat.jpg" alt="Nejat Abiba" />
        </div>
        <div class="profile-info">
            <h1 class="profile-title">Nejat Abiba</h1>
            <p class="profile-subtitle">Full-Stack Developer | Anime Enthusiast</p>

            <h2 class="section-title">About Me</h2>
            <div class="profile-content">
                <p>
                    Hello! I'm Nejat Abiba, a part-time student at the University of Cincinnati, and currently working as a full-stack developer.
                    I enjoy building practical applications at home that I will use myself, as well as playing video games, and hitting the gym.
                    I also love to travel. My favorite destination is Norway for its nature, and especially its people.
                </p>
                <p>
                    I created this website, not only as the final project for my Web Server Application Development Class, but as an homage to one
                    of my favorite types of media. Anime. From as far back as I can remember, I was watching anime; my youth being filled with various
                    Hayao Miyazaki films. To this day, one of my favorite movies of all time is Nausicaä of the Valley of the Wind, which I annoyed my siblings
                    with by watching it over and over again.
                </p>
                <p>
                    Growing older and watching more anime has shown me the various genres and deep stories that exist within the world of Japanese animation.
                    I hope you can enjoy this platform and find a story that you can connect with like I have.
                </p>
                <p>Thank you!</p>
            </div>

            <h2 class="section-title">Professional Experience</h2>
            <div class="experience-timeline">
                <div class="experience-item">
                    <div class="experience-header">
                        <div>
                            <div class="experience-title">Associate Developer</div>
                            <div class="experience-company">Preferred Risk Insurance Services</div>
                        </div>
                        <div class="experience-date">Aug 2024 - Present</div>
                    </div>
                    <div class="tech-tags">
                        <span class="tech-tag">Next.js</span>
                        <span class="tech-tag">.NET</span>
                        <span class="tech-tag">Azure DevOps</span>
                    </div>
                </div>

                <div class="experience-item">
                    <div class="experience-header">
                        <div>
                            <div class="experience-title">Full-Stack Developer Intern</div>
                            <div class="experience-company">Preferred Risk Insurance Services</div>
                        </div>
                        <div class="experience-date">May 2024 - Aug 2024</div>
                    </div>
                    <div class="tech-tags">
                        <span class="tech-tag">Next.js</span>
                        <span class="tech-tag">.NET</span>
                        <span class="tech-tag">Azure DevOps</span>
                    </div>
                </div>
            </div>

            <a asp-controller="Anime" asp-action="Browse" class="btn btn-secondary">Get to Finding Anime!</a>
        </div>
    </div>
</div>
