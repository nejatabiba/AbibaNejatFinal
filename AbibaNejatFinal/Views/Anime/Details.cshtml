@model AbibaNejatFinal.Models.Anime
@{
    ViewData["Title"] = Model.Title;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - AnimeList</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0f1419;
            color: #fff;
            min-height: 100vh;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(45deg, #fff, #f0f0f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .nav-links a:hover {
            opacity: 0.8;
        }

        .hero-banner {
            position: relative;
            width: 100%;
            height: 400px;
            overflow: hidden;
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, rgba(15, 20, 25, 0.3), rgba(15, 20, 25, 1));
            z-index: 1;
        }

        .hero-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(8px);
            transform: scale(1.1);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            position: relative;
            z-index: 2;
            margin-top: -200px;
        }

        .anime-details {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 2rem;
            align-items: start;
        }

        .anime-poster {
            width: 100%;
            border-radius: 15px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        .anime-poster img {
            width: 100%;
            display: block;
        }

        .anime-info {
            padding-top: 100px;
        }

        .anime-title {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .anime-meta {
            display: flex;
            gap: 2rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .meta-item {
            display: flex;
            flex-direction: column;
            background: rgba(255, 255, 255, 0.1);
            padding: 1rem 1.5rem;
            border-radius: 10px;
            min-width: 100px;
            text-align: center;
        }

        .meta-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            opacity: 0.7;
            margin-bottom: 0.25rem;
        }

        .meta-value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .meta-value.score {
            color: #ffc107;
        }

        .section-title {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            margin-top: 2rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .anime-synopsis {
            line-height: 1.8;
            font-size: 1.05rem;
            opacity: 0.9;
            white-space: pre-line;
        }

        .btn {
            padding: 0.8rem 2rem;
            font-size: 1rem;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
            margin-top: 1.5rem;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .btn-primary {
            background: #0f3460;
            color: #fff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .btn-primary:hover {
            background: #16213e;
            transform: translateY(-2px);
        }

        .btn-danger {
            background: #dc3545;
            color: #fff;
        }

        .btn-danger:hover {
            background: #c82333;
            transform: translateY(-2px);
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .action-buttons form {
            display: inline;
        }

        .rating-section {
            margin-top: 2rem;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
        }

        .rating-section h3 {
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }

        .rating-stars {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .rating-stars button {
            width: 40px;
            height: 40px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .rating-stars button:hover {
            background: #0f3460;
            border-color: #0f3460;
            transform: scale(1.1);
        }

        .rating-stars button.active {
            background: #ffc107;
            border-color: #ffc107;
            color: #000;
        }

        .current-rating {
            margin-top: 1rem;
            font-size: 0.95rem;
            opacity: 0.8;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 2rem;
            padding-top: 80px;
        }

        @@media (max-width: 900px) {
            .anime-details {
                grid-template-columns: 1fr;
            }

            .anime-poster {
                max-width: 300px;
                margin: 0 auto;
            }

            .anime-info {
                padding-top: 1rem;
                text-align: center;
            }

            .anime-meta {
                justify-content: center;
            }

            .anime-title {
                font-size: 1.8rem;
            }

            .hero-banner {
                height: 300px;
            }

            .container {
                margin-top: -100px;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <a asp-controller="Home" asp-action="Index" class="logo">AnimeList</a>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Anime" asp-action="Browse">Browse</a></li>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="Anime" asp-action="MyList">My List</a></li>
                <li><a asp-controller="Account" asp-action="Logout">Logout</a></li>
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Login">Login</a></li>
            }
        </ul>
    </nav>

    <div class="hero-banner">
        <img src="@(Model.LargeImageUrl ?? Model.ImageUrl)" alt="@Model.Title" />
    </div>

    <div class="container">
        <div class="anime-details">
            <div class="anime-poster">
                <img src="@(Model.LargeImageUrl ?? Model.ImageUrl)" alt="@Model.Title" />
            </div>
            <div class="anime-info">
                <h1 class="anime-title">@Model.Title</h1>

                <div class="anime-meta">
                    @if (Model.Score.HasValue)
                    {
                        <div class="meta-item">
                            <span class="meta-label">Score</span>
                            <span class="meta-value score">@Model.Score.Value.ToString("0.00")</span>
                        </div>
                    }
                    @if (Model.Episodes.HasValue)
                    {
                        <div class="meta-item">
                            <span class="meta-label">Episodes</span>
                            <span class="meta-value">@Model.Episodes</span>
                        </div>
                    }
                </div>

                <h2 class="section-title">Synopsis</h2>
                <p class="anime-synopsis">@(Model.Summary ?? "No synopsis available.")</p>

                <div class="action-buttons">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        @if (ViewBag.IsInList == true)
                        {
                            <form asp-controller="Anime" asp-action="RemoveFromList" method="post">
                                <input type="hidden" name="malId" value="@Model.MalId" />
                                <button type="submit" class="btn btn-danger">Remove from List</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Anime" asp-action="AddToList" method="post">
                                <input type="hidden" name="malId" value="@Model.MalId" />
                                <button type="submit" class="btn btn-primary">Add to My List</button>
                            </form>
                        }
                    }
                    <a asp-controller="Anime" asp-action="Browse" class="btn btn-secondary">Back to Browse</a>
                </div>

                @if (User?.Identity?.IsAuthenticated == true && ViewBag.IsInList == true)
                {
                    <div class="rating-section">
                        <h3>Your Rating</h3>
                        <form asp-controller="Anime" asp-action="RateAnime" method="post">
                            <input type="hidden" name="malId" value="@Model.MalId" />
                            <div class="rating-stars">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <button type="submit" name="rating" value="@i" class="@(ViewBag.UserRating == i ? "active" : "")">@i</button>
                                }
                            </div>
                        </form>
                        @if (ViewBag.UserRating != null)
                        {
                            <p class="current-rating">You rated this anime: @ViewBag.UserRating/10</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
