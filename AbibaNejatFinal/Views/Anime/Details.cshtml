@model AbibaNejatFinal.Models.Anime
@{
    ViewData["Title"] = Model.Title;
    ViewData["BodyClass"] = "details-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/details.css" />
}

<div class="hero-banner">
    <img src="@(Model.LargeImageUrl ?? Model.ImageUrl)" alt="@Model.Title" />
</div>

<div class="container">
    <div class="anime-details">
        <div class="anime-poster">
            <img src="@(Model.LargeImageUrl ?? Model.ImageUrl)" alt="@Model.Title" />
        </div>
        <div class="anime-info">
            <h1 class="anime-title">@Model.Title</h1>

            <div class="anime-meta">
                @if (Model.Score.HasValue)
                {
                    <div class="meta-item">
                        <span class="meta-label">Score</span>
                        <span class="meta-value score">@Model.Score.Value.ToString("0.00")</span>
                    </div>
                }
                @if (Model.Episodes.HasValue)
                {
                    <div class="meta-item">
                        <span class="meta-label">Episodes</span>
                        <span class="meta-value">@Model.Episodes</span>
                    </div>
                }
            </div>

            <h2 class="section-title">Synopsis</h2>
            <p class="anime-synopsis">@(Model.Summary ?? "No synopsis available.")</p>

            <div class="action-buttons">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    @if (ViewBag.IsInList == true)
                    {
                        <form asp-controller="Anime" asp-action="RemoveFromList" method="post">
                            <input type="hidden" name="malId" value="@Model.MalId" />
                            <button type="submit" class="btn btn-danger">Remove from List</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Anime" asp-action="AddToList" method="post">
                            <input type="hidden" name="malId" value="@Model.MalId" />
                            <button type="submit" class="btn btn-primary">Add to My List</button>
                        </form>
                    }
                }
                <a asp-controller="Anime" asp-action="Browse" class="btn btn-secondary">Back to Browse</a>
            </div>

            @if (User?.Identity?.IsAuthenticated == true && ViewBag.IsInList == true)
            {
                <div class="rating-section">
                    <h3>Your Rating</h3>
                    <form asp-controller="Anime" asp-action="RateAnime" method="post">
                        <input type="hidden" name="malId" value="@Model.MalId" />
                        <div class="rating-stars">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <button type="submit" name="rating" value="@i" class="@(ViewBag.UserRating == i ? "active" : "")">@i</button>
                            }
                        </div>
                    </form>
                    @if (ViewBag.UserRating != null)
                    {
                        <p class="current-rating">You rated this anime: @ViewBag.UserRating/10</p>
                    }
                </div>
            }
        </div>
    </div>
</div>
