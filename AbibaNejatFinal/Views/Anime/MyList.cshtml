@model List<AbibaNejatFinal.Models.UserAnimeViewModel>
@{
    ViewData["Title"] = "My Anime List";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0f1419;
            color: #fff;
            min-height: 100vh;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 5%;
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(45deg, #fff, #f0f0f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .nav-links a:hover {
            opacity: 0.8;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 100px 2rem 2rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .page-header p {
            opacity: 0.8;
        }

        .anime-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .anime-card {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
            aspect-ratio: 3/4;
            cursor: pointer;
            text-decoration: none;
            display: block;
        }

        .anime-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .anime-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .anime-card-title {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 1rem;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent);
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            line-height: 1.3;
        }

        .anime-card-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.9);
            padding: 1rem;
            display: flex;
            flex-direction: column;
            opacity: 0;
            transition: opacity 0.3s ease;
            overflow: hidden;
        }

        .anime-card:hover .anime-card-overlay {
            opacity: 1;
        }

        .anime-card-overlay h3 {
            font-size: 1rem;
            margin-bottom: 0.5rem;
            color: #fff;
        }

        .anime-card-meta {
            display: flex;
            gap: 1rem;
            margin-bottom: 0.75rem;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .anime-card-meta span {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .user-rating-badge {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: #ffc107;
            color: #000;
            padding: 0.4rem 0.6rem;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.9rem;
            z-index: 5;
        }

        .anime-card-summary {
            font-size: 0.8rem;
            line-height: 1.5;
            color: rgba(255, 255, 255, 0.9);
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 8;
            -webkit-box-orient: vertical;
            flex: 1;
        }

        .empty-list {
            text-align: center;
            padding: 4rem 2rem;
        }

        .empty-list h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            opacity: 0.8;
        }

        .empty-list p {
            opacity: 0.6;
            margin-bottom: 2rem;
        }

        .btn {
            padding: 0.8rem 2rem;
            font-size: 1rem;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-primary {
            background: #0f3460;
            color: #fff;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .btn-primary:hover {
            background: #16213e;
            transform: translateY(-2px);
        }

        @@media (max-width: 768px) {
            .page-header h1 {
                font-size: 1.8rem;
            }

            .anime-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 1rem;
            }

            .nav-links {
                gap: 1rem;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="page-header">
            <h1>My Anime List</h1>
            <p>@Model.Count anime in your list</p>
        </div>

        @if (Model.Any())
        {
            <div class="anime-grid">
                @foreach (var item in Model)
                {
                    <a asp-controller="Anime" asp-action="Details" asp-route-id="@item.Anime.MalId" class="anime-card">
                        <img src="@(item.Anime.LargeImageUrl ?? item.Anime.ImageUrl)" alt="@item.Anime.Title" loading="lazy" />
                        <div class="anime-card-title">@item.Anime.Title</div>
                        @if (item.UserRating.HasValue)
                        {
                            <div class="user-rating-badge">@item.UserRating/10</div>
                        }
                        <div class="anime-card-overlay">
                            <h3>@item.Anime.Title</h3>
                            <div class="anime-card-meta">
                                @if (item.Anime.Episodes.HasValue)
                                {
                                    <span>@item.Anime.Episodes eps</span>
                                }
                                @if (item.Anime.Score.HasValue)
                                {
                                    <span>MAL: @item.Anime.Score.Value.ToString("0.00")</span>
                                }
                                @if (item.UserRating.HasValue)
                                {
                                    <span>Your: @item.UserRating/10</span>
                                }
                            </div>
                            <p class="anime-card-summary">
                                @(item.Anime.Summary ?? "No summary available.")
                            </p>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-list">
                <h2>Your list is empty</h2>
                <p>Start browsing and add some anime to your list!</p>
                <a asp-controller="Anime" asp-action="Browse" class="btn btn-primary">Browse Anime</a>
            </div>
        }
    </div>
</body>
</html>
